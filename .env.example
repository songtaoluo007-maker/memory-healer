DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=5
DEEPSEEK_TOTAL_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_FAILURE_THRESHOLD=5
DEEPSEEK_COOLDOWN_SECONDS=30
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/game.db
ENVIRONMENT=development
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_SECONDS=2592000
TTS_CACHE_DIR=./data/tts_cache
TTS_MAX_CONCURRENCY=2
TTS_MAX_CACHE_FILES=500
TTS_MAX_CACHE_BYTES=268435456
FRONTEND_PORT=5173
